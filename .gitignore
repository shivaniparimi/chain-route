# Secrets and credentials — never commit these
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
*.p12
*.pfx
*.crt
*.cer
credentials.json
credentials.yaml
secrets.json
secrets.yaml
*.pgpass
.netrc

# Build output (subdirectory .gitignores already cover router/build/,
# cpp-routing-service/build/, go-api/server — this is a repo-wide catch-all
# for any future build directory)
build/
cmake-build-*/
*.o
*.a
*.so
*.dylib
*.exe

# IDE and editor files
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
.cache/

# Claude Code local session/worktree state — not project source
.claude/

# Phase 10 observability stack local state
observability/*.local.yml

# Terraform local state and working directories — real state/plans/vars
# must never be committed; *.tfvars.example files stay tracked.
# (.terraform.lock.hcl is intentionally NOT ignored -- HashiCorp recommends
# committing it for reproducible provider version selection.)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.tfplan
crash.log
crash.*.log
