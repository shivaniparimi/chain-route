# Core (read by both the server and the worker)
DATABASE_URL=postgres://user:password@localhost:5432/chainroute?sslmode=disable
# BLOCKCHAIN_ENV=testnet enables live Across/Relay quoting and real signed
# Sepolia/Base Sepolia execution. Leave empty (or omit) for simulated,
# network-free mode -- the default this repo's scripts/tools assume.
BLOCKCHAIN_ENV=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Go server (go-api/cmd/server)
MAX_TESTNET_AMOUNT_WEI=
ACROSS_TESTNET_API_URL=https://testnet.across.to/api
ACROSS_API_KEY=
ACROSS_INTEGRATOR_ID=
RELAY_TESTNET_API_URL=https://api.testnets.relay.link
RELAY_API_KEY=
ROUTING_QUOTE_TTL_SECONDS=

# Go worker (go-api/cmd/worker)
METRICS_ADDR=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
KAFKA_CONSUMER_GROUP=
OUTBOX_POLL_INTERVAL_MS=
WORKER_RECOVERY_SWEEP_INTERVAL_SECONDS=
WORKER_RECOVERY_STALENESS_SECONDS=
TESTNET_HANDLE_TIMEOUT_SECONDS=

# Testnet-only (worker; only read when BLOCKCHAIN_ENV=testnet above)
TESTNET_WALLET_PRIVATE_KEY=
ETHEREUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
RELAY_DEPOSIT_CONTRACT_SEPOLIA=
RECONCILE_STALENESS_SECONDS=
RECONCILE_SWEEP_INTERVAL_SECONDS=
NONCE_DIVERGENCE_CHECK_INTERVAL_SECONDS=
MAX_FEE_SLIPPAGE_BPS=

# Docker Compose only (docker-compose.yml) -- not read directly by either Go
# binary; used to build the postgres/migrate/go-server/go-worker services'
# DATABASE_URL. Defaults to chainroute_local_dev via Compose's own
# ${POSTGRES_PASSWORD:-chainroute_local_dev} if left empty/unset.
POSTGRES_PASSWORD=
